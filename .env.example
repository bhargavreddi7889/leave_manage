# Database Configuration
# For Supabase: Use connection pooler URL with pgbouncer=true
# For local PostgreSQL: Remove sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require&pgbouncer=true"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-secret-key-here"

# Application Name (Optional)
APP_NAME="Rakshak Securitas Leave Management System"
